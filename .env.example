# Core app config
FIESTAAA_API_BASE_URL=http://localhost:8080
FIESTAAA_APP_BASE_URL=http://localhost:5001
# OAuth Web client ID. Also used as Android google_sign_in serverClientId.
FIESTAAA_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
FIESTAAA_APPLE_APP_ID=com.example.app
FIESTAAA_APPLE_SERVICE_ID=
FIESTAAA_APPLE_REDIRECT_URI=
FIESTAAA_FCM_VAPID_KEY=your_fcm_vapid_key

# Shared Firebase config
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_MEASUREMENT_ID=
# Optional. Leave empty to default to "${FIREBASE_PROJECT_ID}.firebaseapp.com".
FIREBASE_AUTH_DOMAIN=

# Mobile Firebase config
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_BUNDLE_ID=com.example.app

# Optional: CI/local Android build helpers
ANDROID_GOOGLE_SERVICES_JSON=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
